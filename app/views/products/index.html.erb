<%# app/views/products/index.html.erb %>
<h1>Products</h1>

<div id="products">
  <% @products.each do |product| %>
    <div>
      <%
=begin%>
<a href="/products/<%= product.id %>">
        <%= product.name %>
      </a> 
<%
=end  %>

      <%= link_to product.name, product_path(product.id) %>

    </div>
  <% end %>
</div>